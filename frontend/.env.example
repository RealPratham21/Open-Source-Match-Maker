# Supabase Cloud: Project Settings → API.
# Local development: use the API URL and anon key printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe publishable key. Never put a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Older/local projects may expose an anon key instead. Use one public key variable, not both.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only token for public repository and issue discovery.
# A classic PAT with no scopes works for broad public-repository discovery.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN

# Optional server-only Cohere key for repository-grounded contributor briefs.
COHERE_API_KEY=

# Optional override. Defaults to command-a-03-2025.
# COHERE_MODEL=command-a-03-2025
